# Edge function secrets for LOCAL development (`npm run functions:serve`).
# Copy to supabase/functions/.env (gitignored). In production, set each with:
#   npx supabase secrets set NAME=value
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided automatically.

# Plaid (https://dashboard.plaid.com/developers/keys). Use sandbox until everything works.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_COUNTRY_CODES=US

# Public URL of the plaid-webhook function (leave empty locally; Plaid can't reach localhost).
# Production: https://<project-ref>.supabase.co/functions/v1/plaid-webhook
PLAID_WEBHOOK_URL=

# Only needed for OAuth institutions (must be registered in the Plaid dashboard).
# e.g. https://your-app.example.com/plaid/oauth
PLAID_REDIRECT_URI=

# 32-byte base64 key that encrypts Plaid access tokens at rest: `npm run keygen`
PLAID_TOKEN_ENCRYPTION_KEY=

# Shared secret for the scheduled-sync function (any long random string).
CRON_SECRET=

# Comma-separated origins allowed to call the functions from a browser (empty = any).
ALLOWED_ORIGINS=http://localhost:5173
