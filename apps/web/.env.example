# Public, browser-safe values only. Everything here ships in the JS bundle.
# NEVER put the service-role key, Plaid secret, or encryption key in a VITE_ variable.

# Supabase project URL and anon/publishable key (Project Settings -> API).
# Local: printed by `npx supabase start`.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
